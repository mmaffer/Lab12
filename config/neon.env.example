# GymnasioDb en Neon. Copia esta configuracion a .env cuando crees la nueva base.
# Sustituye marcadores con el enlace de Connect de la base GymnasioDb.
# El proyecto acepta URI PostgreSQL y tambien formato ADO.NET.
LocalDatabase__Enabled=false
ConnectionStrings__DefaultConnection=postgresql://TU_USUARIO:TU_PASSWORD@ep-TU-ENDPOINT.us-east-2.aws.neon.tech/GymnasioDb?sslmode=require&channel_binding=require
Cors__AllowedOrigins__0=http://localhost:5001
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5001
